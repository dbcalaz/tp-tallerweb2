// Esquema de datos de Taller Web II.
// Después de configurar DATABASE_URL, aplicar con:
// npx prisma migrate dev --name crear_usuarios

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  nombre       String
  apellido     String
  direccion    String
  createdAt    DateTime @default(now())
  cart         Cart?

  @@map("users")
}


model Categoria {
  id             Int             @id @default(autoincrement())
  nombre         String          @unique
  tiposProducto  TipoProducto[]

  @@map("categorias")
}

model TipoProducto {
  id           Int        @id @default(autoincrement())
  nombre       String
  categoriaId  Int
  categoria    Categoria  @relation(fields: [categoriaId], references: [id])
  productos    Producto[]

  @@unique([nombre, categoriaId])
  @@map("tipos_productos")
}

model Marca {
  id         Int        @id @default(autoincrement())
  nombre     String     @unique
  productos  Producto[]

  @@map("marcas")
}

model Producto {
  id              Int          @id @default(autoincrement())
  nombre          String
  descripcion     String
  precio          Decimal      @db.Decimal(12, 2)
  imagenUrl       String?
  tipoProductoId  Int
  marcaId         Int
  stock           Int @default(0)
  activo          Boolean      @default(true)

  tipoProducto    TipoProducto @relation(fields: [tipoProductoId], references: [id])
  marca           Marca        @relation(fields: [marcaId], references: [id])
  cartItems       CartItem[]

  @@map("productos")
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  productId Int
  cantidad  Int      @default(1)
  
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  producto  Producto @relation(fields: [productId], references: [id])

  @@unique([cartId, productId]) 
  @@map("cart_items")
}
