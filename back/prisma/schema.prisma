// Esquema de datos de Taller Web II.
// Después de configurar DATABASE_URL, aplicar con:
// npx prisma migrate dev --name crear_usuarios

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  nombre       String
  apellido     String
  direccion    String
  createdAt    DateTime @default(now())

  carrito      Carrito?
  compras      Compra[]

  @@map("users")
}

model Categoria {
  id            Int            @id @default(autoincrement())
  nombre        String         @unique
  imagenUrl     String?        @map("imagen_url")
  tiposProducto TipoProducto[]

  @@map("categorias")
}

model TipoProducto {
  id          Int        @id @default(autoincrement())
  nombre      String
  categoriaId Int
  categoria   Categoria  @relation(fields: [categoriaId], references: [id])
  productos   Producto[]

  @@unique([nombre, categoriaId])
  @@map("tipos_productos")
}

model Marca {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  productos Producto[]

  @@map("marcas")
}

model Producto {
  id               Int               @id @default(autoincrement())
  nombre           String
  descripcion      String
  precio           Decimal           @db.Decimal(12, 2)
  imagenUrl        String?
  tipoProductoId   Int
  marcaId          Int
  stock            Int               @default(0)
  activo           Boolean           @default(true)

  tipoProducto     TipoProducto      @relation(fields: [tipoProductoId], references: [id])
  marca            Marca             @relation(fields: [marcaId], references: [id])
  carritoProductos CarritoProducto[]
  detallesCompras  DetalleCompra[]

  @@map("productos")
}

model Carrito {
  id        Int               @id @default(autoincrement())
  userId    Int               @unique
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CarritoProducto[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@map("carritos")
}

model CarritoProducto {
  id         Int      @id @default(autoincrement())
  carritoId  Int
  productoId Int
  cantidad   Int      @default(1)
  createdAt  DateTime @default(now())

  carrito  Carrito  @relation(fields: [carritoId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@unique([carritoId, productoId])
  @@map("carrito_productos")
}

model Compra {
  id             Int             @id @default(autoincrement())
  userId         Int
  total          Decimal         @db.Decimal(12, 2)
  estado         String          @default("PENDIENTE")
  direccionEnvio String?
  createdAt      DateTime        @default(now())

  user     User            @relation(fields: [userId], references: [id])
  detalles DetalleCompra[]

  @@map("compras")
}

model DetalleCompra {
  id             Int      @id @default(autoincrement())
  compraId       Int
  productoId     Int
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(12, 2)

  compra   Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@map("detalles_compras")
}