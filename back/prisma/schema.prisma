// Esquema de datos de Taller Web II.
// Después de configurar DATABASE_URL, aplicar con:
// npx prisma migrate dev --name crear_usuarios

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nombre       String
  apellido     String
  direccion    String
  createdAt    DateTime @default(now())

  @@map("users")
}